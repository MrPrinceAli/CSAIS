# Salin file ini menjadi .env (sudah di-gitignore) lalu isi nilainya.
# main.py membaca .env otomatis saat mulai; variabel yang sudah ada di
# lingkungan tidak ditimpa.

# Turso (SQLite hosted), dipakai oleh `main.py --publish` / `--publish-only`.
#   turso db show csais --url      -> libsql://csais-namaanda.turso.io
#   turso db tokens create csais   -> token panjang (rahasia)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Opsional: lokasi database SQLite lokal selain database/csais.db
# CSAIS_DB_PATH=
