# Salin file ini menjadi .env (sudah di-gitignore) lalu isi nilainya.
# main.py membaca .env otomatis saat mulai; variabel yang sudah ada di
# lingkungan tidak ditimpa.

# Turso (SQLite hosted), dipakai oleh `main.py --publish` / `--publish-only`.
#   turso db show csais --url      -> libsql://csais-namaanda.turso.io
#   turso db tokens create csais   -> token panjang (rahasia)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Database survei publik (alur D2), terpisah dari database utama.
#   turso db show csais-survey --url
#   turso db tokens create csais-survey --read-only   -> cukup untuk pipeline
SURVEY_DATABASE_URL=
SURVEY_AUTH_TOKEN=

# Token TULIS database masukan, hanya untuk perintah lokal --anchor dan --llm-extract
#   turso db tokens create csais-survey
SURVEY_WRITE_TOKEN=

# LLM lokal (LM Studio: tab Developer > Start Server)
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=
# LLM_NO_THINK=1        # model Qwen: jangan tulis penalaran panjang
# LLM_JSON_SCHEMA=1     # 0 bila server tidak mendukung response_format json_schema
# LLM_TIMEOUT=120

# Blockchain lokal (scripts/chain_local.sh)
# CHAIN_RPC_URL=http://127.0.0.1:8545
# CHAIN_NAME=anvil-lokal

# Opsional: lokasi database SQLite lokal selain database/csais.db
# CSAIS_DB_PATH=
